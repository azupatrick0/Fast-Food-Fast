{
  "name": "fast-food-fast",
  "version": "1.0.0",
  "description": "Fast-Food-Fast​ is a food delivery service app for a restaurant.",
  "scripts": {
    "start": "npm run start:webpack:prod && npm run create-table-users-prod && npm run create-table-items-prod && npm run create-table-orders-prod && npm run build && node ./Server/dist/index.js ",
    "start:dev": "cross-env NODE_ENV=development npm run start:webpack:dev & npm-run-all --serial create-table-users-dev create-table-items-dev create-table-orders-dev start-server",
    "start-server": "nodemon --exec babel-node ./Server/src/index.js",
    "start:webpack:dev": "webpack --mode development --watch",
    "start:webpack:prod": "webpack --mode production",
    "pretest": "npm run lint",
    "test": "npm run create-table-users-test && npm run create-table-items-test && npm run create-table-orders-test && cross-env NODE_ENV=test nyc mocha --exit  ./Server/src/test/testSpec.js --require @babel/register --require ignore-styles --timeout 250000",
    "test:client": "cross-env NODE_ENV=test nyc mocha --exit --require ./Client/setup.js ./Client/test/index.js --require @babel/register --require ignore-styles --timeout 250000",
    "test:e2e": "testcafe chrome ./Client/test/e2e/order.js",
    "build": "npm run clean && babel ./Server/src -d ./Server/dist",
    "lint": "./node_modules/.bin/eslint ./Client ./Server --fix --ignore-path .gitignore",
    "clean": "rimraf ./Server/dist",
    "coverage": "nyc report --reporter=text-lcov | coveralls",
    "create-table-users-dev": "cross-env NODE_ENV=development babel-node ./Server/src/models/users.js",
    "create-table-items-dev": "cross-env NODE_ENV=development babel-node ./Server/src/models/menu.js",
    "create-table-orders-dev": "cross-env NODE_ENV=development babel-node ./Server/src/models/orders.js",
    "create-table-users-test": "cross-env NODE_ENV=test babel-node ./Server/src/models/users.js",
    "create-table-items-test": "cross-env NODE_ENV=test babel-node ./Server/src/models/menu.js",
    "create-table-orders-test": "cross-env NODE_ENV=test babel-node ./Server/src/models/orders.js",
    "create-table-users-prod": "cross-env NODE_ENV=production babel-node ./Server/src/models/users.js",
    "create-table-items-prod": "cross-env NODE_ENV=production babel-node ./Server/src/models/menu.js",
    "create-table-orders-prod": "cross-env NODE_ENV=production babel-node ./Server/src/models/orders.js"
  },
  "engines": {
    "node": "18.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azupatrick0/Fast-Food-Fast.git"
  },
  "keywords": [
    "Fast",
    "food",
    "restaurant",
    "online"
  ],
  "author": "Azu Patrick",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/azupatrick0/Fast-Food-Fast/issues"
  },
  "homepage": "https://github.com/azupatrick0/Fast-Food-Fast#readme",
  "dependencies": {
    "@babel/cli": "^7.27.2",
    "@babel/core": "^7.27.4",
    "@babel/node": "^7.27.1",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/register": "^7.27.1",
    "@babel/runtime": "^7.27.4",
    "@types/dotenv": "^8.2.3",
    "axios": "^0.18.1",
    "babel-loader": "^8.4.1",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-stage-0": "^6.24.1",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.18.3",
    "browser-env": "^3.3.0",
    "chai": "^4.5.0",
    "chai-http": "^4.4.0",
    "cors": "^2.8.5",
    "css-loader": "0.23.1",
    "dotenv": "^6.2.0",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.8",
    "express": "^4.21.2",
    "fetch-mock": "^7.7.3",
    "file-loader": "^3.0.1",
    "html-webpack-plugin": "^3.2.0",
    "image-loader": "0.0.1",
    "image-webpack-loader": "^4.6.0",
    "jquery": "^3.7.1",
    "jsdom": "^13.1.0",
    "jsonwebtoken": "^8.5.1",
    "moxios": "^0.4.0",
    "node-fetch": "^2.7.0",
    "node-localstorage": "^1.3.1",
    "npm-run-all": "^4.1.5",
    "pg": "^8.16.0",
    "prop-types": "^15.8.1",
    "random-email": "^1.0.3",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-helmet": "^5.2.1",
    "react-redux": "^6.0.1",
    "react-router": "^4.3.1",
    "react-router-dom": "^4.3.1",
    "react-router-redux": "4.0.4",
    "react-stripe-checkout": "^2.6.3",
    "react-toastify": "^5.5.0",
    "redux": "^4.2.1",
    "redux-devtools-extension": "^2.13.9",
    "redux-logger": "^3.0.6",
    "redux-mock-store": "^1.5.5",
    "redux-persist": "^5.10.0",
    "redux-thunk": "^2.4.2",
    "sinon": "^7.5.0",
    "stripe": "^7.63.1",
    "style-loader": "0.13.1",
    "testcafe": "^1.20.1",
    "toastr": "2.1.2",
    "url-loader": "^1.1.2",
    "uuidv4": "^5.0.1",
    "webpack": "^4.47.0",
    "webpack-cli": "^3.3.12",
    "webpack-dev-middleware": "^3.7.3"
  },
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "browser-env": "^3.3.0",
    "coveralls": "^3.1.1",
    "cross-env": "^5.2.1",
    "css-loader": "0.23.1",
    "eslint": "^4.19.1",
    "eslint-config-airbnb-base": "^12.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "5.0.1",
    "eslint-watch": "^4.0.2",
    "expect": "1.19.0",
    "html-webpack-plugin": "^3.2.0",
    "ignore-styles": "^5.0.1",
    "image-webpack-loader": "^4.6.0",
    "mocha": "^5.2.0",
    "nock": "8.0.0",
    "nodemon": "^1.19.4",
    "nyc": "^12.0.2",
    "react-dom": "^16.14.0",
    "redux-devtools-extension": "^2.13.9",
    "rimraf": "^2.7.1",
    "style-loader": "0.13.1",
    "webpack-cli": "^3.3.12",
    "webpack-dev-server": "^3.11.3"
  }
}
